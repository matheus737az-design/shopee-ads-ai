# Servidor
PORT=3333

# Pasta onde os dados ficam salvos (arquivos .json: produtos, anúncios, publicações)
# ATENÇÃO (Render free tier): o disco do serviço free NÃO é persistente — ele é
# apagado a cada novo deploy/restart. Os dados ficam disponíveis enquanto a
# instância estiver no ar, mas podem sumir depois de um redeploy. Se isso for
# um problema, veja a seção "Persistência de dados" no README.md.
DATA_DIR=./data

# --- API oficial de afiliados da Shopee (produto real + link de afiliado) ---
# Preencha os dois para usar dados reais de produto e gerar links de afiliado
# de verdade. Sem eles, o app cai automaticamente para scraping da página
# pública (produto) e devolve o link original sem modificar (afiliado).
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=

# --- IA real para os textos (opcional) ---
# Se preenchida, os textos (título, legenda WhatsApp, legenda Instagram, CTA,
# versão alternativa) são gerados pela IA da Anthropic (Claude) de verdade.
# Sem ela, o app usa um gerador por template local — nunca finge ser IA real.
ANTHROPIC_API_KEY=

# --- CORS (opcional) ---
# Deixe em branco para aceitar qualquer origem (padrão, ok para uso same-origin
# como este projeto roda). Preencha só se for necessário restringir a um
# domínio específico de frontend.
ALLOWED_ORIGIN=

# --- Automação do Instagram (veja "Publicação automática no Instagram" no README) ---
# Senha do painel (aba "Instagram"). SEM ela o painel fica desligado.
ADMIN_PASSWORD=
# (Opcional) Segredo para disparar um ciclo manualmente via POST /api/automation/tick
# com o header x-cron-secret. O agendamento normal já roda DENTRO do servidor.
CRON_SECRET=
# Endereço público do site, ex: https://shopee-ads-ai.onrender.com (a Meta baixa a imagem daqui)
PUBLIC_BASE_URL=
# Conta profissional do Instagram + token da Meta (o token EXPIRA, ~60 dias)
IG_USER_ID=
IG_ACCESS_TOKEN=
# Padrão https://graph.facebook.com (token via Facebook Login). Se o token veio do
# "Instagram Login", use https://graph.instagram.com
IG_GRAPH_BASE=
IG_GRAPH_VERSION=v21.0
# Regras de quantidade (o sistema nunca passa de 25/24h, mesmo que você ponha mais)
IG_MAX_POSTS_PER_DAY=3
IG_MIN_HOURS_BETWEEN_POSTS=4
IG_POST_WINDOW_START=8
IG_POST_WINDOW_END=22
IG_TIMEZONE=America/Sao_Paulo
# #publi é sempre incluído (post de afiliado é publicidade)
IG_HASHTAGS=#publi #shopee #achadinhos #ofertas
# Junto com cada post do feed, publica um story do mesmo produto (false = só feed)
IG_ALSO_STORY=true
# Texto do botão desenhado no story (a API não permite sticker de link)
IG_STORY_CTA=LINK NA BIO
# approval = só publica o que você aprovar (recomendado) | auto = publica sozinho
AUTOMATION_MODE=approval
# true = busca produtos em alta sozinho e enfileira
AUTOMATION_AUTOFILL=false
AUTOMATION_QUEUE_TARGET=2
AUTOMATION_DEDUPE_DAYS=30
# --- Agendador interno (piloto automático) ---
# Liga sozinho no servidor. Use "off" para desligar (ex.: rodando no seu computador).
AUTOMATION_SCHEDULER=
# De quantos em quantos minutos o ciclo roda (as regras acima decidem se posta)
AUTOMATION_TICK_MINUTES=20
# Mantém o Render grátis acordado (senão ele dorme após 15 min sem visitas)
KEEP_AWAKE=true
# (Opcional, recomendado) Chave da API do Render: permite salvar sozinho o token
# do Instagram renovado (a cada 7 dias), para ele nunca expirar.
# Crie em dashboard.render.com > Account Settings > API Keys.
RENDER_API_KEY=

# Consulta de "em alta" da Shopee (2 = mais vendidos). Ajuste só se a Shopee recusar.
SHOPEE_TRENDING_SORT_TYPE=2
SHOPEE_TRENDING_LIST_TYPE=

# NUNCA coloque essas chaves no frontend nem faça commit de um arquivo .env
# de verdade — elas só existem aqui, no backend, e o .gitignore já impede
# que .env seja versionado.
