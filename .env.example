# Servidor
PORT=3333

# Pasta onde os dados ficam salvos (arquivos .json)
DATA_DIR=./data

# --- Fonte dos dados de produto ---
# Por padrão o backend tenta SCRAPING real da página da Shopee.
# Se SHOPEE_API_KEY estiver preenchida, ele usa a API oficial no lugar
# (ainda não implementada — ver services/productService.js).
SHOPEE_API_KEY=

# --- Outras chaves reais (deixe em branco por enquanto — texto ainda é mock) ---
AI_PROVIDER_API_KEY=
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=

# NUNCA coloque essas chaves no frontend. Elas só existem aqui, no backend.
